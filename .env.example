# 한국투자 Open API에서 발급받은 값을 입력하세요.
# 실제 값이 들어간 .env 파일은 Git에 올리지 않습니다.
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret

# 실전 시세 조회용 주소입니다. V1에는 주문 기능이 없습니다.
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 1001: 코스닥, 0001: 코스피, 0000: 전체
KIS_MARKET_CODE=1001

# 한국투자 공식 예제와 문서 사이에 길이 차이가 발생할 수 있어 설정으로 분리합니다.
KIS_EXCLUDE_CODE=000000

